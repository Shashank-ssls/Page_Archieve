# Keep LF line endings in the repo and the working tree on every OS,
# so Windows checkouts match the Linux-tested sources byte for byte.
* text=auto eol=lf

*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.txt text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
